{
  "name": "audioaulas-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "description": "Audioaulas: player das audioaulas de estudo, com download dos MP3 pelo GitHub Releases e leitura em voz do aparelho como reserva (React Native/Expo)",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "catalogo": "node scripts/catalogo.js",
    "publicar-aulas": "node scripts/publicar-aulas.js",
    "icones": "node scripts/icones.js",
    "test": "node --no-warnings --test test/",
    "apk": "npx eas-cli@latest build -p android --profile apk",
    "apk:local": "npx expo prebuild -p android --clean && cd android && .\\gradlew.bat assembleRelease",
    "lint": "eslint App.js src scripts test"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-file-system": "~58.0.14",
    "expo-keep-awake": "~58.0.4",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^17.14.0",
    "sharp": "^0.35.5"
  }
}
